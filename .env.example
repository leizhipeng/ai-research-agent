# Copy this file to .env locally. Do not commit real credentials.
OPENAI_API_KEY=replace-with-your-api-key
# Manus-compatible proxy or another OpenAI-compatible API base URL.
OPENAI_API_BASE=https://api.example.com/v1
RESEARCH_AGENT_MODEL=gpt-5-mini
RESEARCH_AGENT_MAX_STEPS=5
RESEARCH_AGENT_MAX_SEARCH_RESULTS=5
RESEARCH_AGENT_TIMEOUT_SECONDS=45
