# Copy this file to .env locally. Do not commit real credentials.
OPENAI_API_KEY=replace-with-your-api-key
# OPENAI_BASE_URL=https://api.example.com/v1
RESEARCH_AGENT_MODEL=gpt-5-mini
# Settings below apply only to the small manual-loop example.
RESEARCH_AGENT_MAX_STEPS=5
RESEARCH_AGENT_MAX_SEARCH_RESULTS=5
RESEARCH_AGENT_TIMEOUT_SECONDS=45
# Optional OpenAlex key increases the provider's free allowance.
# OPENALEX_API_KEY=replace-with-your-openalex-key
# Explicit compatibility mode for endpoints without native JSON Schema support.
# RESEARCH_AGENT_JSON_MODE=true
RESEARCH_AGENT_MAX_OUTPUT_TOKENS=2400
